# ─── AIVOA Complaint Intelligence — backend configuration ────────────────────
# Copy to `.env` and fill in. Every value has a working default except the key.

ENVIRONMENT=development
DEBUG=true

# ── Groq ─────────────────────────────────────────────────────────────────────
# Create a token at https://console.groq.com/keys
# Leave blank to run the deterministic engine (the app still works end to end).
GROQ_API_KEY=
# The assignment names gemma2-9b-it / llama-3.3-70b-versatile. Groq has since
# decommissioned the former and gated the latter to Enterprise accounts, so
# these default to the nearest current equivalents -- change them back if
# your Groq account has access to the originally-named models.
# See docs/DEPLOYMENT.md, Step 0.
EXTRACTION_MODEL=openai/gpt-oss-20b
REASONING_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (zero setup, default):
DATABASE_URL=sqlite+pysqlite:///./aivoa.db
# PostgreSQL (docker-compose supplies this automatically):
# DATABASE_URL=postgresql+psycopg://aivoa:aivoa@localhost:5432/aivoa
# MySQL:
# DATABASE_URL=mysql+pymysql://aivoa:aivoa@localhost:3306/aivoa

# ── Behaviour ────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
DUPLICATE_SCORE_THRESHOLD=0.62
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
