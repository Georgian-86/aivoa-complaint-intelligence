# Normalise line endings so the repository is identical on Windows, macOS and
# Linux, and so CI (which runs on Linux) sees exactly what was committed.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or some shells mis-parse them.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Never touch these.
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Keep the lockfile out of diffs by default; it is still versioned.
package-lock.json -diff
